diff --git a/src/sm_onion_control.c b/src/sm_onion_control.c
new file mode 100644
index 0000000..0513196
--- /dev/null
+++ b/src/sm_onion_control.c
@@ -0,0 +1,128 @@
+#include "sm_platform.h"
+
+#include <pthread.h>
+#include <stdatomic.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+
+#include "sm_log.h"
+#include "sm_onion_control.h"
+#include "sm_runtime.h"
+
+#define ONION_CONTROL_SOCKET                                                  \
+  "/system_tmp/onionhen/ipc/shadowmountplus_service"
+
+static pthread_t g_control_thread;
+static atomic_bool g_control_running = false;
+static int g_control_server_fd = -1;
+
+static bool write_all(int fd, const char *text) {
+  size_t remaining = strlen(text);
+  const char *cursor = text;
+  while (remaining > 0) {
+    ssize_t written = send(fd, cursor, remaining, MSG_NOSIGNAL);
+    if (written < 0 && errno == EINTR)
+      continue;
+    if (written <= 0)
+      return false;
+    cursor += written;
+    remaining -= (size_t)written;
+  }
+  return true;
+}
+
+static void handle_control_client(int fd) {
+  char command[64];
+  ssize_t size;
+  do {
+    size = read(fd, command, sizeof(command) - 1);
+  } while (size < 0 && errno == EINTR);
+  if (size <= 0)
+    return;
+
+  command[size] = '\0';
+  command[strcspn(command, "\r\n")] = '\0';
+  if (strcmp(command, "scan") == 0) {
+    request_scan_now("OnionHEN Facade");
+    (void)write_all(fd, "OK scan_requested\n");
+  } else if (strcmp(command, "status") == 0) {
+    (void)write_all(fd, "OK running\n");
+  } else if (strcmp(command, "shutdown") == 0) {
+    request_shutdown_stop("OnionHEN Facade");
+    (void)write_all(fd, "OK shutdown_requested\n");
+  } else {
+    (void)write_all(fd, "ERR unknown_command\n");
+  }
+}
+
+static void *control_thread_main(void *unused) {
+  (void)unused;
+  while (atomic_load_explicit(&g_control_running, memory_order_acquire)) {
+    int client_fd = accept(g_control_server_fd, NULL, NULL);
+    if (client_fd < 0) {
+      if (errno == EINTR)
+        continue;
+      if (!atomic_load_explicit(&g_control_running, memory_order_acquire))
+        break;
+      log_debug("  [ONION] control accept failed: %s", strerror(errno));
+      continue;
+    }
+    handle_control_client(client_fd);
+    close(client_fd);
+  }
+  return NULL;
+}
+
+bool sm_onion_control_start(void) {
+  if (atomic_load_explicit(&g_control_running, memory_order_acquire))
+    return true;
+
+  (void)mkdir("/system_tmp/onionhen", 0777);
+  (void)mkdir("/system_tmp/onionhen/ipc", 0777);
+  (void)unlink(ONION_CONTROL_SOCKET);
+
+  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0)
+    return false;
+
+  struct sockaddr_un address;
+  memset(&address, 0, sizeof(address));
+  address.sun_family = AF_UNIX;
+  (void)strlcpy(address.sun_path, ONION_CONTROL_SOCKET,
+                sizeof(address.sun_path));
+  if (bind(fd, (struct sockaddr *)&address, sizeof(address)) != 0 ||
+      listen(fd, 4) != 0) {
+    close(fd);
+    (void)unlink(ONION_CONTROL_SOCKET);
+    return false;
+  }
+  (void)chmod(ONION_CONTROL_SOCKET, 0666);
+
+  g_control_server_fd = fd;
+  atomic_store_explicit(&g_control_running, true, memory_order_release);
+  if (pthread_create(&g_control_thread, NULL, control_thread_main, NULL) != 0) {
+    atomic_store_explicit(&g_control_running, false, memory_order_release);
+    close(g_control_server_fd);
+    g_control_server_fd = -1;
+    (void)unlink(ONION_CONTROL_SOCKET);
+    return false;
+  }
+  log_debug("  [ONION] control service ready: %s", ONION_CONTROL_SOCKET);
+  return true;
+}
+
+void sm_onion_control_stop(void) {
+  if (!atomic_exchange_explicit(&g_control_running, false,
+                                memory_order_acq_rel)) {
+    (void)unlink(ONION_CONTROL_SOCKET);
+    return;
+  }
+
+  if (g_control_server_fd >= 0) {
+    (void)shutdown(g_control_server_fd, SHUT_RDWR);
+    close(g_control_server_fd);
+    g_control_server_fd = -1;
+  }
+  (void)pthread_join(g_control_thread, NULL);
+  (void)unlink(ONION_CONTROL_SOCKET);
+}
