+#ifndef SM_ONION_CONTROL_H
+#define SM_ONION_CONTROL_H
+
+#include <stdbool.h>
+
+// OnionHEN's optional process-control adapter. Scanner behavior remains in the
+// upstream runtime; this service only forwards commands to its public hooks.
+bool sm_onion_control_start(void);
+void sm_onion_control_stop(void);
+
+#endif
